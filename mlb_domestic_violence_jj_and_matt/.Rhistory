dvcount_6pmto6am = dv_hour_18+dv_hour_19+dv_hour_20+dv_hour_21+dv_hour_22+dv_hour_23+dv_hour_0+dv_hour_1+dv_hour_2+dv_hour_3+dv_hour_4+dv_hour_5,
